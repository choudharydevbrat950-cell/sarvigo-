
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sarvigo | Agriculture Store</title>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7f2;
      color: #203126;
    }

    header {
      background: #176b3a;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 { margin: 0 0 8px; }
    header p { margin: 0; }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 18px;
    }

    .toolbar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    input, select, textarea, button {
      font: inherit;
      padding: 12px;
      border-radius: 8px;
    }

    input, select, textarea {
      border: 1px solid #cbd5cc;
      width: 100%;
      background: white;
    }

    .toolbar input { flex: 1; min-width: 180px; }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
    }

    .card, .panel {
      background: white;
      padding: 18px;
      border-radius: 12px;
      box-shadow: 0 2px 8px #0000000c;
    }

    .product-icon { font-size: 38px; }
    .price { color: #176b3a; font-size: 20px; font-weight: bold; }

    button {
      border: none;
      background: #176b3a;
      color: white;
      cursor: pointer;
      font-weight: bold;
    }

    button:disabled {
      opacity: .6;
      cursor: wait;
    }

    .secondary { background: #52645a; }
    .danger { background: #a33232; }

    .card button { width: 100%; margin-top: 10px; }

    .layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 24px;
      align-items: start;
    }

    .field { margin: 12px 0; }
    .field label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }

    .cart-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      border-bottom: 1px solid #eee;
      padding: 10px 0;
    }

    .qty { display: flex; align-items: center; gap: 8px; }
    .qty button { padding: 5px 10px; }
    .total { font-size: 22px; font-weight: bold; margin: 18px 0; }

    #message {
      margin: 15px 0;
      padding: 12px;
      border-radius: 8px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    footer {
      padding: 24px;
      text-align: center;
      color: #53635a;
    }

    @media (max-width: 700px) {
      .layout { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <header>
    <h1>🌱 Sarvigo</h1>
    <p>Your Agriculture Shopping Partner</p>
  </header>

  <main class="container">
    <h2>Shop Agriculture Products</h2>

    <div class="toolbar">
      <input
        id="search"
        type="search"
        placeholder="Search seeds, fertilizer, tools..."
        aria-label="Search products"
      >
      <button class="secondary" onclick="loadProducts()">
        Refresh Products
      </button>
    </div>

    <div id="products" class="products">
      Loading products...
    </div>

    <div class="layout">
      <section class="panel">
        <h2>🛒 Your Cart</h2>
        <div id="cart">Your cart is empty.</div>
        <div class="total">Total: <span id="total">₹0</span></div>
        <button class="secondary" onclick="clearCart()">Clear Cart</button>
      </section>

      <section class="panel">
        <h2>📦 Checkout</h2>

        <form id="checkoutForm">
          <div class="field">
            <label for="name">Full Name</label>
            <input id="name" name="name" required minlength="2" maxlength="100">
          </div>

          <div class="field">
            <label for="phone">Mobile Number</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              inputmode="numeric"
              pattern="[6-9][0-9]{9}"
              maxlength="10"
              placeholder="10-digit mobile number"
              required
            >
          </div>

          <div class="field">
            <label for="address">Full Delivery Address</label>
            <textarea id="address" name="address"
              required minlength="5" maxlength="500"></textarea>
          </div>

          <div class="field">
            <label for="city">City / Village</label>
            <input id="city" name="city" required minlength="2" maxlength="100">
          </div>

          <div class="field">
            <label for="pincode">PIN Code</label>
            <input
              id="pincode"
              name="pincode"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              required
            >
          </div>

          <div class="field">
            <label for="paymentMethod">Payment Method</label>
            <select id="paymentMethod" required>
              <option value="COD">Cash on Delivery (COD)</option>
              <option value="ONLINE">Online Payment (Razorpay)</option>
            </select>
          </div>

          <button id="placeOrder" type="submit" style="width:100%">
            Place Order / Pay Now
          </button>
        </form>

        <div id="message" role="status" aria-live="polite" hidden></div>
      </section>
    </div>
  </main>

  <footer>
    Sarvigo Agriculture Store · Seeds · Fertilizers · Farming Tools
  </footer>

  <script>
    let products = [];
    let cart = {};

    const productIcons = {
      1: "🌱", 2: "🌾", 3: "🧪", 4: "🍃",
      5: "💦", 6: "🚿", 7: "🌿", 8: "🛠️"
    };

    const productsBox = document.getElementById("products");
    const cartBox = document.getElementById("cart");
    const totalBox = document.getElementById("total");
    const messageBox = document.getElementById("message");
    const orderButton = document.getElementById("placeOrder");

    function money(amount) {
      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 2
      }).format(amount);
    }

    function showMessage(message) {
      messageBox.hidden = false;
      messageBox.textContent = message;
    }

    async function api(url, body) {
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || "Request failed.");
      }

      return data;
    }

    async function loadProducts() {
      try {
        const response = await fetch("/api/products");
        if (!response.ok) throw new Error("Could not load products.");

        products = await response.json();
        renderProducts();
        renderCart();
      } catch (error) {
        productsBox.textContent =
          "Products could not load. Please start the server first.";
      }
    }

    function renderProducts() {
      const query = document.getElementById("search")
        .value.trim().toLowerCase();

      const filtered = products.filter(product =>
        product.name.toLowerCase().includes(query)
      );

      productsBox.replaceChildren();

      if (!filtered.length) {
        productsBox.textContent = "No products found.";
        return;
      }

      filtered.forEach(product => {
        const card = document.createElement("article");
        card.className = "card";

        const icon = document.createElement("div");
        icon.className = "product-icon";
        icon.textContent = productIcons[product.id] || "🌿";

        const title = document.createElement("h3");
        title.textContent = product.name;

        const price = document.createElement("p");
        price.className = "price";
        price.textContent = money(product.price);

        const button = document.createElement("button");
        button.textContent = "Add to Cart";
        button.addEventListener("click", () => addToCart(product.id));

        card.append(icon, title, price, button);
        productsBox.append(card);
      });
    }

    function addToCart(id) {
      const current = cart[id] || 0;

      if (current >= 20) {
        showMessage("Maximum 20 units of each product allowed.");
        return;
      }

      cart[id] = current + 1;
      renderCart();
      showMessage("Product added to your cart.");
    }

    function changeQuantity(id, change) {
      const next = (cart[id] || 0) + change;

      if (next <= 0) {
        delete cart[id];
      } else if (next <= 20) {
        cart[id] = next;
      }

      renderCart();
    }

    function clearCart() {
      cart = {};
      renderCart();
      showMessage("Cart cleared.");
    }

    function getCartItems() {
      return Object.entries(cart).map(([id, quantity]) => ({
        id: Number(id),
        quantity
      }));
    }

    function renderCart() {
      cartBox.replaceChildren();

      const entries = Object.entries(cart);
      let total = 0;

      if (!entries.length) {
        cartBox.textContent = "Your cart is empty.";
        totalBox.textContent = money(0);
        return;
      }

      entries.forEach(([id, quantity]) => {
        const product = products.find(p => p.id === Number(id));
        if (!product) return;

        total += product.price * quantity;

        const row = document.createElement("div");
        row.className = "cart-row";

        const details = document.createElement("div");
        details.textContent =
          `${product.name} — ${money(product.price * quantity)}`;

        const qty = document.createElement("div");
        qty.className = "qty";

        const minus = document.createElement("button");
        minus.type = "button";
        minus.textContent = "−";
        minus.setAttribute("aria-label", "Decrease quantity");
        minus.addEventListener("click", () =>
          changeQuantity(Number(id), -1)
        );

        const count = document.createElement("span");
        count.textContent = String(quantity);

        const plus = document.createElement("button");
        plus.type = "button";
        plus.textContent = "+";
        plus.setAttribute("aria-label", "Increase quantity");
        plus.addEventListener("click", () =>
          changeQuantity(Number(id), 1)
        );

        qty.append(minus, count, plus);
        row.append(details, qty);
        cartBox.append(row);
      });

      totalBox.textContent = money(total);
    }

    function getCustomer() {
      return {
        name: document.getElementById("name").value.trim(),
        phone: document.getElementById("phone").value.trim(),
        address: document.getElementById("address").value.trim(),
        city: document.getElementById("city").value.trim(),
        pincode: document.getElementById("pincode").value.trim()
      };
    }

    async function payOnline(items, customer) {
      const order = await api("/api/payment/create-order", {
        items,
        customer
      });

      if (!window.Razorpay) {
        throw new Error("Payment window could not load. Check your internet.");
      }

      return new Promise((resolve, reject) => {
        let finished = false;

        const checkout = new Razorpay({
          key: order.keyId,
          amount: order.amount,
          currency: order.currency,
          name: "Sarvigo",
          description: "Agriculture products",
          order_id: order.orderId,

          prefill: {
            name: customer.name,
            contact: customer.phone
          },

          theme: { color: "#176b3a" },

          handler: async function (payment) {
            try {
              const result = await api("/api/payment/verify", payment);

              finished = true;
              resolve(result);
            } catch (error) {
              finished = true;
              reject(new Error(
                "Payment verification did not complete. Do not retry payment blindly. " +
                "Keep your payment ID: " +
                (payment.razorpay_payment_id || "not available") +
                ". Contact the store to confirm status."
              ));
            }
          },

          modal: {
            ondismiss: function () {
              if (!finished) {
                reject(new Error(
                  "Payment window closed. Check payment status before trying again."
                ));
              }
            }
          }
        });

        checkout.on("payment.failed", function (event) {
          finished = true;
          reject(new Error(
            event.error?.description || "Payment failed. Please check its status."
          ));
        });

        checkout.open();
      });
    }

    document.getElementById("search").addEventListener("input", renderProducts);

    document.getElementById("checkoutForm")
      .addEventListener("submit", async function (event) {
        event.preventDefault();
        messageBox.hidden = true;

        if (!this.reportValidity()) return;

        const items = getCartItems();

        if (!items.length) {
          showMessage("Please add products to your cart first.");
          return;
        }

        const customer = getCustomer();
        const method = document.getElementById("paymentMethod").value;

        orderButton.disabled = true;
        orderButton.textContent = "Please wait...";

        try {
          if (method === "COD") {
            const result = await api("/api/orders/cod", {
              items,
              customer
            });

            cart = {};
            renderCart();

            showMessage(
              "COD order created!\n" +
              "Order ID: " + result.orderId + "\n" +
              "Total: " + money(result.total) + "\n" +
              "Status: " + result.status +
              "\n\nDemo only: this example does not yet save orders permanently or notify a delivery team."
            );
          } else {
            const result = await payOnline(items, customer);

            cart = {};
            renderCart();

            showMessage(
              "Payment signature verified.\n" +
              "Order ID: " + result.orderId +
              "\nStatus: " + result.status +
              "\n\nProduction setup must also confirm payment status and amount with Razorpay and process verified webhooks before dispatch."
            );
          }
        } catch (error) {
          showMessage(error.message || "Something went wrong.");
        } finally {
          orderButton.disabled = false;
          orderButton.textContent = "Place Order / Pay Now";
        }
      });

    loadProducts();
  </script>
</body>
</html>
